# Copie en .env (jamais commité). En regtest, « python scripts/regtest.py init » le remplit tout seul.

# --- Réseau : regtest | signet | testnet | mainnet --------------------------------------
LIGHTNING_RESEAU=regtest

# --- Ports exposés sur 127.0.0.1 (à changer si un autre projet les utilise déjà) ---------
LNBITS_PORT=5000
PONT_PORT=18001

# --- LNbits (vu depuis le backend, qui tourne hors Docker) ------------------------------
LNBITS_URL=http://127.0.0.1:5000
LNBITS_INVOICE_KEY=
# Clé ADMIN : permet de DÉPENSER. Reste uniquement côté serveur.
LNBITS_ADMIN_KEY=

# --- Webhook : URL du pont, telle que LNbits (dans Docker) la voit -----------------------
PONT_JETON_WEBHOOK=
LIGHTNING_WEBHOOK_URL=
# Secret envoyé par le pont au backend (en-tête X-Jeton-Pont) : seul le pont peut confirmer une cotisation
PONT_JETON_BACKEND=

# --- Adresses Lightning de test : nom@regtest.local servies par le pont -----------------
LNURL_DOMAINES_LOCAUX=regtest.local=http://127.0.0.1:18001

# --- Garde-fous ---------------------------------------------------------------------------
LIGHTNING_MAX_FACTURE_SATS=1000000
LIGHTNING_MAX_VERSEMENT_SATS=500000
LIGHTNING_FRAIS_MAX_POURCENT=1.0
LIGHTNING_EXPIRATION_FACTURE_S=604800
LIGHTNING_DELAI_SUIVI_S=10
LIGHTNING_SEUIL_ABANDON_S=120
# Par défaut : ~/.tontine_lightning/versements-<réseau>.sqlite3 (chemin absolu obligatoire en mainnet)
#LIGHTNING_REGISTRE=

# --- Backend vu depuis le pont (Docker -> machine hôte) ------------------------------------
BACKEND_URL=http://host.docker.internal:8000
