# Démo MAINNET — vrais sats. Copier en .env.mainnet (jamais commité).
LIGHTNING_RESEAU=mainnet
LNBITS_URL=http://127.0.0.1:5000

# phoenixd tourne sur la machine hôte : mot de passe dans ~/.phoenix/phoenix.conf (http-password)
LNBITS_BACKEND_WALLET_CLASS=PhoenixdWallet
PHOENIXD_API_ENDPOINT=http://host.docker.internal:9740/
PHOENIXD_API_PASSWORD=

# Créer le portefeuille : curl -X POST http://127.0.0.1:5000/api/v1/account -H "Content-Type: application/json" -d '{"name":"Tontine"}'
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
PONT_JETON_WEBHOOK=
LIGHTNING_WEBHOOK_URL=http://pont:8000/webhook/lnbits?jeton=<même jeton>
PONT_JETON_BACKEND=
COMPOSE_PROFILES=pont
# Chemin ABSOLU obligatoire en mainnet (ex. C:\\Users\\alassane\\.tontine_lightning\\versements-mainnet.sqlite3)
LIGHTNING_REGISTRE=

# Plafonds BAS pour une démo avec de l'argent réel
LIGHTNING_MAX_FACTURE_SATS=20000
LIGHTNING_MAX_VERSEMENT_SATS=20000
LNURL_AUTORISER_RESEAU_PRIVE=false
LNURL_VERIFIER_DESCRIPTION_HASH=true
BACKEND_URL=http://host.docker.internal:8000
